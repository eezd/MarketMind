# Source deployment: copy to .env.production and protect with chmod 600.
# Keep the filled file outside Git and readable only by the service account.
MM_DATABASE_URL=
MM_REDIS_URL=redis://127.0.0.1:6379/0

# Exact public Origin, without a trailing slash; production requires HTTPS.
MM_ALLOWED_ORIGINS=https://marketmind.example.invalid
MM_COOKIE_SECURE=true
# A shared, privately generated Fernet key; never print it or commit the filled file.
MM_SESSION_KEY=

# Reverse proxy terminates HTTPS and forwards to the locally managed web/API services.
MM_TELEGRAM_PROXY_URL=
# Configure notification credentials through the authenticated management UI.
MM_TELEGRAM_ENABLED=false

# 可选 OpenAI 兼容接口。密钥仅通过受保护环境文件提供；未配置时摘要状态为 fallback。
MM_AI_BASE_URL=
MM_AI_API_KEY=
MM_AI_MODEL=
# 推理强度：minimal、low、medium、high；兼容服务不支持时设为 disabled。
MM_AI_REASONING_EFFORT=medium
MM_AI_TIMEOUT_SECONDS=30

# Fixed SOCKS5 egress reachable from the service host; unavailable means no direct fallback.
MM_BINANCE_PROXY_URL=socks5://127.0.0.1:12123
# 仅使用无交易权限的 API Key；公开行情不需要 API Secret。
MM_BINANCE_API_KEY=
MM_BINANCE_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
MM_BINANCE_STOCK_SYMBOLS=AAPL,NVDA,TSLA,SPY,QQQ
MM_BINANCE_SYNC_INTERVAL_SECONDS=60
