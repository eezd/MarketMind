# 仅本地隔离开发；不是已有生产数据库的连接配置。
MM_DEV_DATABASE_PASSWORD=
MM_DEV_POSTGRES_PORT=55432
MM_DEV_REDIS_PORT=56379
MM_DATABASE_URL=postgresql+psycopg://marketmind_dev:CHANGE_ME@127.0.0.1:55432/marketmind_dev
MM_REDIS_URL=redis://127.0.0.1:56379/0
MM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MM_COOKIE_SECURE=false
# Vite 开发代理目标；API 端口冲突时按实际监听地址覆盖。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 可选 OpenAI 兼容接口；未配置时保留可追溯的规则摘要，并标记 fallback。
MM_AI_BASE_URL=
MM_AI_API_KEY=
MM_AI_MODEL=
# 推理强度：minimal、low、medium、high；兼容服务不支持时设为 disabled。
MM_AI_REASONING_EFFORT=medium
MM_AI_TIMEOUT_SECONDS=30

# 币安公开行情固定走 SOCKS5；代理不可用时禁止直连。
MM_BINANCE_PROXY_URL=socks5://127.0.0.1:12123
# 美股 MARKET_DATA 端点要求 API Key 请求头，但不需要 Secret 或交易权限。
MM_BINANCE_API_KEY=
MM_BINANCE_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT
MM_BINANCE_STOCK_SYMBOLS=AAPL,NVDA,TSLA,SPY,QQQ
MM_BINANCE_SYNC_INTERVAL_SECONDS=60
